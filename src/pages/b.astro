---
import Base from "../layouts/Base.astro";
import VariantB from "../components/variants/VariantB.tsx";
import { VARIANT_FONT, VARIANT_TITLE } from "../lib/variantMeta";
---

<Base title={VARIANT_TITLE.B}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={VARIANT_FONT.B} rel="stylesheet" />
  </Fragment>
  <VariantB client:load />
</Base>

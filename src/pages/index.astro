---
import { resolveVariant, variantPath } from "../lib/variant";

// The variant is resolved here. With the hard-coded flag this happens at BUILD
// time and bakes a redirect to the chosen variant into the static index page.
//
// To run the real experiment later, do the assignment per-visitor instead:
//   • Edge (no flicker, preferred): a Cloudflare Pages Function at functions/index.ts
//     evaluates GrowthBook, sets a sticky cookie, and 302s to /a | /b | /c.
//   • Client: move resolveVariant() into the inline <script> below.
// Either way the /a /b /c routes and all variant code stay untouched.
const target = variantPath(resolveVariant());
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Datebloom</title>
    <script is:inline define:vars={{ target }}>
      location.replace(target);
    </script>
  </head>
  <body>
    <p>Redirecting… <a href={target}>continue</a></p>
  </body>
</html>

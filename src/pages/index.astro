---
import Base from "../layouts/Base.astro";
import DateApp from "../components/DateApp.tsx";
import { VARIANT_FONT } from "../lib/variantMeta";

// `/` is the only route. The active concept is no longer chosen at build time —
// the <DateApp> island resolves it PER-VISITOR in the browser from the
// experimentation platform (experiment `date_flow_variant`), fires the exposure
// event, and renders the matching concept. So this page is a thin static shell:
// it preloads all three concepts' web fonts (the unused ones never fetch their
// woff2, since only the rendered variant's font-family classes are used) and
// mounts the island, which swaps in the real <title> once the variant resolves.
const FONTS = [VARIANT_FONT.A, VARIANT_FONT.B, VARIANT_FONT.C];
---

<Base title="Date with Mark">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {FONTS.map((href) => <link href={href} rel="stylesheet" />)}
  </Fragment>
  <DateApp client:load />
</Base>

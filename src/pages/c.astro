---
import Base from "../layouts/Base.astro";
import VariantC from "../components/variants/VariantC.tsx";
import { VARIANT_FONT, VARIANT_TITLE } from "../lib/variantMeta";
---

<Base title={VARIANT_TITLE.C}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={VARIANT_FONT.C} rel="stylesheet" />
  </Fragment>
  <VariantC client:load />
</Base>

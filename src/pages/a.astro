---
import Base from "../layouts/Base.astro";
import VariantA from "../components/variants/VariantA.tsx";
import { VARIANT_FONT, VARIANT_TITLE } from "../lib/variantMeta";
---

<Base title={VARIANT_TITLE.A}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={VARIANT_FONT.A} rel="stylesheet" />
  </Fragment>
  <VariantA client:load />
</Base>
